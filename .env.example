# Bot token from @BotFather (Telegram)
BOT_TOKEN=your-bot-token-here

# OpenAI API key (used for both embeddings + chat)
# Get one at https://platform.openai.com/api-keys (requires a funded account)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: override model (default gpt-4o-mini). Use gpt-4o for harder cases.
MODEL=gpt-4o-mini

# Channel where full reports are posted (numeric id with minus sign).
# Example for @Padid_Avaran_Edalat:
CHANNEL_ID=-1004458550016

# Admin user IDs that always have full access (comma separated).
ADMIN_IDS=67391189,125472442

# How many free analyses before locking (optional; default 1)
TRIAL_QUESTIONS=1
